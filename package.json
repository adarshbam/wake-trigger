  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adarshbam/wake-trigger.git"
  },
  "homepage": "https://github.com/adarshbam/wake-trigger#readme",
  "bugs": {
    "url": "https://github.com/adarshbam/wake-trigger/issues"
  },
  "engines": {
    "node": ">=20"
  },
